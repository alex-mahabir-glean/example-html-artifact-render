# Query endpoint, including scheme. Example: https://your-instance-be.glean.com
GLEAN_SERVER_URL=

# Optional. Defaults to 3000.
# PORT=3000

# User-scoped Client API tokens. Chat uses these on /rest/api/v1/chat.
USER_1=
USER_1_CLIENT_TOKEN=
USER_2=
USER_2_CLIENT_TOKEN=

# Auth Token API key. The server mints a web session with
# POST /rest/api/v1/createauthtoken and X-Glean-ActAs set to the selected user,
# then calls /api/v1/artifacts with that session token.
GLEAN_AUTH_TOKEN_API_KEY=
